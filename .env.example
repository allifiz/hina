# Primary AI provider: 9Router running on the same Azure VPS
# Copy your actual API key only into the server .env (never into Git).
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_MODEL=ag/gpt-oss-120b-medium

# Optional llama.cpp fallback (disable on low-RAM Azure VM)
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL_NAME=local-model
LOCAL_MODEL_API_KEY=local

# Optional cloud fallbacks
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODELS=
OPENROUTER_SITE_URL=https://github.com/allifiz/hina
OPENROUTER_APP_NAME=WhatsApp Bot Hina

QWEN_API_KEY=
QWEN_MODEL_SMART=qwen3.7-plus
QWEN_MODEL_FALLBACK=qwen3.6-flash
QWEN_MODEL_VISION=qwen3.5-plus-2026-02-15
QWEN_MODEL_IMAGE=qwen-image
QWEN_MODEL_ASR=qwen3-asr-flash-2025-09-08
QWEN_MODEL_TTS=qwen3-tts-flash-2025-09-18
QWEN_TTS_VOICE=Cherry

TAVILY_API_KEY=
